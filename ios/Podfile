require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('expo-widgets/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'reffen' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # ExpoModulesCore, ExpoUI and React are linked into the Live Activity extension too.
    expo_widgets_post_install(installer)

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix error of "react-native-enriched-markdown": "^0.7.1"
    # Delete when fixed
    # “RaTeX.xcframework-ios.signature” couldn’t be copied to “Signatures” because an item with the same name already exists.
    # Failure Reason: A file with the name “RaTeX.xcframework-ios.signature” already exists.

    # The RaTeX SPM binary (pulled in by react-native-enriched-markdown for LaTeX
    # math) emits its `.signature` file both at the top of BUILT_PRODUCTS_DIR and
    # inside the pod's own build dir. During *archive*, Xcode flattens every
    # *.signature into <archive>/Signatures/ keyed by filename, so the two copies
    # collide with NSCocoaErrorDomain 516 ("file exists"). Delete the nested
    # duplicate at build time, leaving the canonical top-level one.

    installer.pods_project.targets.each do |target|
      next unless target.name == 'ReactNativeEnrichedMarkdown'

      phase = target.new_shell_script_build_phase('Remove duplicate RaTeX signature')
      phase.shell_script = 'rm -f "${BUILT_PRODUCTS_DIR}/RaTeX.xcframework-ios.signature"'
      phase.run_only_for_deployment_postprocessing = '0'
    end
  end
end

# The widget extension that draws the model download Live Activity (expo-widgets). It
# links only expo, expo-widgets and @expo/ui (use_expo_modules_widgets!), plus the React
# Native core they depend on.
target 'ExpoWidgetsTarget' do
  # CocoaPods builds a pod shared by two targets as a module only if both ask for it;
  # the app asks for it for several React Native pods, so this target must too or they
  # stop being modules for the app as well.
  use_modular_headers!
  use_expo_modules_widgets!

  config = use_expo_native_module!([
    'node',
    '--no-warnings',
    '--eval',
    'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ])

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end
