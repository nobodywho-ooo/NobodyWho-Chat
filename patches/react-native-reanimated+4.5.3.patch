-  } catch (std::out_of_range) {}
+  auto nativeId = 0;
+  for (int i = 0; i < nativeIdString.length(); i++) {
+    if (nativeIdString[i] < '0' || nativeIdString[i] > '9') {
+      return;
+    }
+    nativeId *= 10;
+    nativeId += nativeIdString[i] - '0';
+  }
+
+  layoutAnimationsManager_->transferConfigFromNativeID(nativeId, tag);
