  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "ReffenSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "ai.nobodywho.mobile.specs"
    },
    "ios": {
      "modulesProvider": {
        "NativeClipboard": "RTNClipboard"
      }
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "overrides": {
    "react-native": "$react-native",
    "expo": "$expo",
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    }
  }
